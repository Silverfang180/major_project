import React, { useState } from 'react';
import { useDashboardStore } from '../../store/dashboardStore';
import type { Role } from '../../store/dashboardStore';
import { Plus, Trash2, Maximize2, Variable, Sparkles } from 'lucide-react';
import Editor from '@monaco-editor/react';
import { motion, AnimatePresence } from 'framer-motion';

export const CenterMessageEditor: React.FC = () => {
    const { messages, addMessage, updateMessage, removeMessage } = useDashboardStore();
    const [focusedMessage, setFocusedMessage] = useState<string | null>(null);

    const handleAddMessage = () => {
        addMessage({
            id: Date.now().toString(),
            role: 'user',
            content: ''
        });
    };

    return (
        <main className="flex-1 flex flex-col min-w-0 bg-background/40 relative">
            <div className="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-900/10 via-background to-background pointer-events-none" />

            <div className="p-4 border-b border-white/5 flex justify-between items-center bg-background/40 backdrop-blur-md z-10 shadow-sm">
                <div className="flex items-center gap-4">
                    <h2 className="font-semibold text-lg flex items-center gap-2.5 text-foreground/90">
                        <span className="p-1.5 rounded-md bg-purple-500/10 border border-purple-500/20">
                            <Sparkles className="w-4 h-4 text-purple-400" />
                        </span>
                        Prompt Canvas
                    </h2>
                    <div className="flex bg-black/20 p-1 rounded-lg border border-white/5">
                        <button className="px-3 py-1 text-sm bg-white/10 shadow-sm rounded-md border text-white font-medium">Editor</button>
                        <button className="px-3 py-1 text-sm text-muted-foreground hover:text-foreground font-medium transition-colors">Variables</button>
                    </div>
                </div>
                <div className="flex items-center gap-2">
                    <motion.button whileHover={{ scale: 1.05 }} whileTap={{ scale: 0.95 }} className="p-2 text-muted-foreground hover:text-foreground hover:bg-white/10 rounded-lg transition-colors border border-transparent hover:border-white/10" title="Add Variable">
                        <Variable className="w-4 h-4" />
                    </motion.button>
                    <motion.button whileHover={{ scale: 1.05 }} whileTap={{ scale: 0.95 }} className="p-2 text-muted-foreground hover:text-foreground hover:bg-white/10 rounded-lg transition-colors border border-transparent hover:border-white/10" title="Expand Editor">
                        <Maximize2 className="w-4 h-4" />
                    </motion.button>
                </div>
            </div>

            <div className="flex-1 overflow-y-auto p-4 md:p-6 lg:p-8 space-y-6 z-10 scroll-hide">
                <AnimatePresence>
                    {messages.map((message, index) => {
                        const isSystem = message.role === 'system';
                        const isFocused = focusedMessage === message.id;

                        return (
                            <motion.div
                                key={message.id}
                                initial={{ opacity: 0, y: 10, scale: 0.98 }}
                                animate={{ opacity: 1, y: 0, scale: 1 }}
                                exit={{ opacity: 0, scale: 0.95, transition: { duration: 0.2 } }}
                                className={`group relative bg-[#1e1e1e]/80 backdrop-blur-3xl border rounded-xl overflow-hidden transition-all duration-300 shadow-lg
                                ${isFocused ? 'ring-1 ring-blue-500/50 border-blue-500/50 shadow-[0_0_30px_rgba(59,130,246,0.15)]' : 'border-white/10 hover:border-white/20'}`
                                }
                            >
                                <div className="flex items-center justify-between px-4 py-2 border-b border-white/5 bg-black/40">
                                    <div className="flex items-center gap-2">
                                        <div className={`w-2 h-2 rounded-full ${isSystem ? 'bg-amber-400' : message.role === 'assistant' ? 'bg-emerald-400' : 'bg-blue-400'} shadow-[0_0_8px_currentColor]`} />
                                        <select
                                            className={`text-sm font-semibold bg-transparent border-none focus:ring-0 cursor-pointer uppercase tracking-wider transition-colors
                                            ${isSystem ? 'text-amber-400' : message.role === 'assistant' ? 'text-emerald-400' : 'text-blue-400'}
                                            hover:brightness-125 outline-none`}
                                            value={message.role}
                                            onChange={(e) => {
                                                const messagesCopy = [...messages];
                                                messagesCopy[index].role = e.target.value as Role;
                                                useDashboardStore.getState().setMessages(messagesCopy);
                                            }}
                                        >
                                            <option value="system" className="bg-[#1e1e1e] text-amber-400">System</option>
                                            <option value="user" className="bg-[#1e1e1e] text-blue-400">User</option>
                                            <option value="assistant" className="bg-[#1e1e1e] text-emerald-400">Assistant</option>
                                        </select>
                                    </div>

                                    <button
                                        onClick={() => removeMessage(message.id)}
                                        className="opacity-0 group-hover:opacity-100 p-1.5 text-muted-foreground hover:text-red-400 hover:bg-red-400/10 rounded-md transition-all border border-transparent hover:border-red-400/20"
                                    >
                                        <Trash2 className="w-4 h-4" />
                                    </button>
                                </div>
                                <div className="h-[120px] relative">
                                    <Editor
                                        height="100%"
                                        defaultLanguage="markdown"
                                        theme="vs-dark"
                                        value={message.content}
                                        onChange={(val) => updateMessage(message.id, val || '')}
                                        onMount={(editor) => {
                                            editor.onDidFocusEditorText(() => setFocusedMessage(message.id));
                                            editor.onDidBlurEditorText(() => setFocusedMessage(null));
                                        }}
                                        options={{
                                            minimap: { enabled: false },
                                            scrollBeyondLastLine: false,
                                            lineNumbers: 'off',
                                            folding: false,
                                            wordWrap: 'on',
                                            padding: { top: 16, bottom: 16 },
                                            renderLineHighlight: 'none',
                                            overviewRulerLanes: 0,
                                            hideCursorInOverviewRuler: true,
                                            scrollbar: { vertical: 'hidden', horizontal: 'hidden' },
                                            fontFamily: "'JetBrains Mono', monospace",
                                            fontSize: 14,
                                            lineHeight: 1.6
                                        }}
                                    />
                                </div>
                            </motion.div>
                        )
                    })}
                </AnimatePresence>

                <motion.button
                    whileHover={{ scale: 1.01, backgroundColor: "rgba(59, 130, 246, 0.05)" }}
                    whileTap={{ scale: 0.99 }}
                    onClick={handleAddMessage}
                    className="w-full flex items-center justify-center gap-2 py-4 border border-dashed border-white/20 rounded-xl text-muted-foreground hover:text-foreground hover:border-blue-500/50 transition-all font-medium shadow-sm group"
                >
                    <Plus className="w-4 h-4 group-hover:text-blue-400 transition-colors" />
                    <span className="text-gradient font-semibold tracking-wide">Add Message</span>
                </motion.button>
            </div>
        </main>
    );
};
