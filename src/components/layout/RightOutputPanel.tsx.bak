import React from 'react';
import { useDashboardStore } from '../../store/dashboardStore';
import { Terminal, Database, PlayCircle, Layers, Activity } from 'lucide-react';
import { motion, AnimatePresence } from 'framer-motion';

export const RightOutputPanel: React.FC = () => {
    const { output, isStreaming, trace } = useDashboardStore();

    return (
        <aside className="w-[350px] lg:w-[420px] border-l border-white/5 flex flex-col h-full bg-background/80 backdrop-blur-3xl shadow-[-2px_0_20px_rgba(0,0,0,0.2)] z-10 relative">
            <div className="absolute inset-0 bg-gradient-to-bl from-purple-900/5 to-transparent pointer-events-none" />

            <div className="p-4 border-b border-white/5 flex justify-between items-center bg-background/40 backdrop-blur-md relative z-10">
                <h2 className="font-semibold text-sm flex items-center gap-2 text-foreground/90 uppercase tracking-wider">
                    <div className="p-1 rounded bg-green-500/10 border border-green-500/20">
                        <Terminal className="w-3.5 h-3.5 text-green-400" />
                    </div>
                    Output
                </h2>
                <div className="flex bg-black/20 p-1 rounded-lg border border-white/5">
                    <button className="px-3 py-1 text-xs bg-white/10 shadow-sm rounded-md border text-white font-medium flex items-center gap-1.5">
                        <Layers className="w-3.5 h-3.5" /> Result
                    </button>
                    <button className="px-3 py-1 text-xs text-muted-foreground hover:text-foreground font-medium flex items-center gap-1.5 transition-colors">
                        <Database className="w-3.5 h-3.5" /> Trace
                    </button>
                </div>
            </div>

            <div className="flex-1 overflow-y-auto p-5 flex flex-col relative z-10 scroll-hide">
                <AnimatePresence>
                    {isStreaming && (
                        <motion.div
                            initial={{ opacity: 0 }}
                            animate={{ opacity: 1 }}
                            exit={{ opacity: 0 }}
                            className="absolute inset-0 z-20 bg-background/60 backdrop-blur-sm flex flex-col items-center justify-center"
                        >
                            <div className="relative w-16 h-16 flex items-center justify-center">
                                <div className="absolute inset-0 border-4 border-blue-500/20 rounded-full"></div>
                                <div className="absolute inset-0 border-4 border-blue-500 rounded-full border-t-transparent animate-spin"></div>
                                <Activity className="w-6 h-6 text-blue-400 animate-pulse" />
                            </div>
                            <span className="mt-4 text-sm font-medium text-blue-400/80 animate-pulse tracking-wide uppercase">Streaming Response...</span>
                        </motion.div>
                    )}
                </AnimatePresence>

                {output ? (
                    <motion.div
                        initial={{ opacity: 0, y: 10 }}
                        animate={{ opacity: 1, y: 0 }}
                        className="prose prose-sm dark:prose-invert max-w-none font-sans"
                    >
                        <div className="whitespace-pre-wrap rounded-xl bg-[#1e1e1e]/60 backdrop-blur-xl border border-white/10 shadow-lg p-5 text-sm leading-relaxed text-foreground/90 font-mono">
                            {output}
                        </div>
                    </motion.div>
                ) : (
                    <div className="flex-1 flex flex-col items-center justify-center text-muted-foreground gap-5 opacity-60">
                        <motion.div
                            whileHover={{ scale: 1.1, rotate: 90 }}
                            transition={{ type: "spring", stiffness: 200, damping: 10 }}
                            className="w-20 h-20 rounded-2xl bg-gradient-to-br from-white/5 to-white/0 flex items-center justify-center border border-white/10 shadow-[0_0_30px_rgba(255,255,255,0.05)]"
                        >
                            <PlayCircle className="w-10 h-10 text-white/50" strokeWidth={1.5} />
                        </motion.div>
                        <p className="text-sm max-w-[220px] text-center leading-relaxed">Execute the prompt canvas to stream the model's output and view execution traces.</p>
                    </div>
                )}
            </div>

            {/* Trace Summary Footer */}
            {trace && (
                <motion.div
                    initial={{ y: 20, opacity: 0 }}
                    animate={{ y: 0, opacity: 1 }}
                    className="p-4 border-t border-white/5 bg-black/40 text-xs flex justify-between items-center font-mono relative z-10"
                >
                    <div className="flex items-center gap-2">
                        <span className="text-muted-foreground">Tokens:</span>
                        <span className="font-semibold text-blue-400 bg-blue-500/10 px-2 py-0.5 rounded border border-blue-500/20">{trace.tokens || 0}</span>
                    </div>
                    <div className="flex items-center gap-2">
                        <span className="text-muted-foreground">Latency:</span>
                        <span className="font-semibold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">{trace.latency || '0ms'}</span>
                    </div>
                </motion.div>
            )}
        </aside>
    );
};
