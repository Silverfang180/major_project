import React from 'react';
import { useDashboardStore } from '../../store/dashboardStore';
import * as Slider from '@radix-ui/react-slider';
import * as Select from '@radix-ui/react-select';
import { ChevronDown, Settings, Save, Clock, Cpu } from 'lucide-react';
import { motion } from 'framer-motion';

export const LeftConfigSidebar: React.FC = () => {
    const { provider, model, temperature, topP, maxTokens, setConfig } = useDashboardStore();

    return (
        <aside className="w-80 border-r border-white/5 bg-background/60 backdrop-blur-2xl flex flex-col h-full shadow-[2px_0_20px_rgba(0,0,0,0.2)] z-10">
            <div className="p-5 border-b border-white/5 flex items-center justify-between bg-gradient-to-b from-primary/5 to-transparent">
                <span className="font-semibold flex items-center gap-2 text-foreground/90">
                    <div className="p-1.5 rounded-md bg-blue-500/10 border border-blue-500/20">
                        <Settings className="w-4 h-4 text-blue-400" />
                    </div>
                    Configuration
                </span>
                <div className="flex gap-2">
                    <motion.button whileHover={{ scale: 1.1 }} whileTap={{ scale: 0.9 }} className="p-1.5 hover:bg-white/10 rounded-md transition-colors shadow-sm" title="Saved Configurations">
                        <Save className="w-4 h-4 text-muted-foreground hover:text-foreground" />
                    </motion.button>
                    <motion.button whileHover={{ scale: 1.1 }} whileTap={{ scale: 0.9 }} className="p-1.5 hover:bg-white/10 rounded-md transition-colors shadow-sm" title="History">
                        <Clock className="w-4 h-4 text-muted-foreground hover:text-foreground" />
                    </motion.button>
                </div>
            </div>

            <div className="p-5 flex flex-col gap-6 overflow-y-auto scroll-hide">
                {/* Provider Select */}
                <div className="flex flex-col gap-2 relative">
                    <label className="text-xs font-semibold text-muted-foreground uppercase tracking-wider flex items-center gap-1.5">
                        <Cpu className="w-3.5 h-3.5" /> Provider
                    </label>
                    <Select.Root value={provider} onValueChange={(val) => setConfig({ provider: val })}>
                        <Select.Trigger className="flex items-center justify-between w-full px-3 py-2 text-sm bg-black/20 border border-white/10 rounded-lg hover:border-white/20 focus:outline-none focus:ring-2 focus:ring-blue-500/50 transition-all shadow-inner group">
                            <Select.Value placeholder="Select provider" />
                            <Select.Icon><ChevronDown className="w-4 h-4 opacity-50 group-hover:opacity-100 transition-opacity" /></Select.Icon>
                        </Select.Trigger>
                        <Select.Portal>
                            <Select.Content className="overflow-hidden bg-background/95 backdrop-blur-xl border border-white/10 rounded-lg shadow-2xl z-50 animate-in fade-in-80 zoom-in-95">
                                <Select.Viewport className="p-1.5">
                                    <Select.Item className="relative flex cursor-pointer select-none items-center rounded-md py-2 pl-8 pr-2 text-sm outline-none hover:bg-blue-500/10 hover:text-blue-400 transition-colors" value="openai">
                                        <Select.ItemText>OpenAI</Select.ItemText>
                                    </Select.Item>
                                    <Select.Item className="relative flex cursor-pointer select-none items-center rounded-md py-2 pl-8 pr-2 text-sm outline-none hover:bg-amber-500/10 hover:text-amber-400 transition-colors" value="anthropic">
                                        <Select.ItemText>Anthropic</Select.ItemText>
                                    </Select.Item>
                                    <Select.Item className="relative flex cursor-pointer select-none items-center rounded-md py-2 pl-8 pr-2 text-sm outline-none hover:bg-emerald-500/10 hover:text-emerald-400 transition-colors" value="groq">
                                        <Select.ItemText>Groq</Select.ItemText>
                                    </Select.Item>
                                </Select.Viewport>
                            </Select.Content>
                        </Select.Portal>
                    </Select.Root>
                </div>

                {/* Model Select */}
                <div className="flex flex-col gap-2">
                    <label className="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Model</label>
                    <Select.Root value={model} onValueChange={(val) => setConfig({ model: val })}>
                        <Select.Trigger className="flex items-center justify-between w-full px-3 py-2 text-sm bg-black/20 border border-white/10 rounded-lg hover:border-white/20 focus:outline-none focus:ring-2 focus:ring-blue-500/50 transition-all shadow-inner group">
                            <Select.Value placeholder="Select model" />
                            <Select.Icon><ChevronDown className="w-4 h-4 opacity-50 group-hover:opacity-100 transition-opacity" /></Select.Icon>
                        </Select.Trigger>
                        <Select.Portal>
                            <Select.Content className="overflow-hidden bg-background/95 backdrop-blur-xl border border-white/10 rounded-lg shadow-2xl z-50">
                                <Select.Viewport className="p-1.5">
                                    <Select.Item className="relative flex cursor-pointer select-none items-center rounded-md py-2 pl-8 pr-2 text-sm outline-none hover:bg-blue-500/10 hover:text-blue-400 transition-colors" value="gpt-4o">
                                        <Select.ItemText>GPT-4o</Select.ItemText>
                                    </Select.Item>
                                    <Select.Item className="relative flex cursor-pointer select-none items-center rounded-md py-2 pl-8 pr-2 text-sm outline-none hover:bg-blue-500/10 hover:text-blue-400 transition-colors" value="gpt-4-turbo">
                                        <Select.ItemText>GPT-4 Turbo</Select.ItemText>
                                    </Select.Item>
                                    <Select.Item className="relative flex cursor-pointer select-none items-center rounded-md py-2 pl-8 pr-2 text-sm outline-none hover:bg-blue-500/10 hover:text-blue-400 transition-colors" value="gpt-3.5-turbo">
                                        <Select.ItemText>GPT-3.5 Turbo</Select.ItemText>
                                    </Select.Item>
                                </Select.Viewport>
                            </Select.Content>
                        </Select.Portal>
                    </Select.Root>
                </div>

                <div className="w-full h-px bg-white/5 my-2"></div>

                {/* Temperature Slider */}
                <div className="flex flex-col gap-4">
                    <div className="flex justify-between items-center">
                        <label className="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Temperature</label>
                        <span className="text-xs font-mono bg-blue-500/10 text-blue-400 border border-blue-500/20 px-2 py-0.5 rounded-md shadow-sm">{temperature.toFixed(2)}</span>
                    </div>
                    <Slider.Root
                        className="relative flex items-center select-none touch-none w-full h-5 cursor-pointer group"
                        value={[temperature]}
                        max={2}
                        step={0.01}
                        onValueChange={(val) => setConfig({ temperature: val[0] })}
                    >
                        <Slider.Track className="bg-white/10 relative grow rounded-full h-[4px] overflow-hidden">
                            <Slider.Range className="absolute bg-gradient-to-r from-blue-500 to-indigo-500 rounded-full h-full" />
                        </Slider.Track>
                        <Slider.Thumb className="block w-4 h-4 bg-white border border-blue-500/50 shadow-[0_0_10px_rgba(59,130,246,0.5)] rounded-full focus:outline-none focus:ring-4 focus:ring-blue-500/30 transition-shadow group-hover:scale-110 active:scale-95" />
                    </Slider.Root>
                </div>

                {/* Top P Slider */}
                <div className="flex flex-col gap-4">
                    <div className="flex justify-between items-center">
                        <label className="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Top P</label>
                        <span className="text-xs font-mono bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 px-2 py-0.5 rounded-md shadow-sm">{topP.toFixed(2)}</span>
                    </div>
                    <Slider.Root
                        className="relative flex items-center select-none touch-none w-full h-5 cursor-pointer group"
                        value={[topP]}
                        max={1}
                        step={0.01}
                        onValueChange={(val) => setConfig({ topP: val[0] })}
                    >
                        <Slider.Track className="bg-white/10 relative grow rounded-full h-[4px] overflow-hidden">
                            <Slider.Range className="absolute bg-gradient-to-r from-indigo-500 to-purple-500 rounded-full h-full" />
                        </Slider.Track>
                        <Slider.Thumb className="block w-4 h-4 bg-white border border-indigo-500/50 shadow-[0_0_10px_rgba(99,102,241,0.5)] rounded-full focus:outline-none focus:ring-4 focus:ring-indigo-500/30 transition-shadow group-hover:scale-110 active:scale-95" />
                    </Slider.Root>
                </div>

                {/* Max Tokens Slider */}
                <div className="flex flex-col gap-4">
                    <div className="flex justify-between items-center">
                        <label className="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Max Tokens</label>
                        <span className="text-xs font-mono bg-purple-500/10 text-purple-400 border border-purple-500/20 px-2 py-0.5 rounded-md shadow-sm">{maxTokens}</span>
                    </div>
                    <Slider.Root
