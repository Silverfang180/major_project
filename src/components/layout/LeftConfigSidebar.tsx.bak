                        </Slider.Track>
                        <Slider.Thumb className="block w-4 h-4 bg-white border border-purple-500/50 shadow-[0_0_10px_rgba(168,85,247,0.5)] rounded-full focus:outline-none focus:ring-4 focus:ring-purple-500/30 transition-shadow group-hover:scale-110 active:scale-95" />
                    </Slider.Root>
